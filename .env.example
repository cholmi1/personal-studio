# Example only. Never put real secrets in this file or Git.
# Local use: copy to .env, then node --env-file=.env src/server.mjs
# Existing 시작.cmd does NOT automatically load .env.
HOST=127.0.0.1
PORT=4318
DATA_DIR=.data
# Optional: environment keys override keys saved through the AI settings dialog.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional persistent encryption secret, at least 32 characters.
# If blank, the server creates a local secret under DATA_DIR. Back it up securely.
STUDIO_SECRET=
# Remote only: uncomment and replace after attaching a persistent /data volume.
# HOST=0.0.0.0
# DATA_DIR=/data
# STUDIO_ALLOW_REMOTE=1
# STUDIO_PUBLIC_ORIGIN=https://YOUR-ACTUAL-SERVICE-DOMAIN
# STUDIO_SETUP_TOKEN=REPLACE-WITH-YOUR-OWN-RANDOM-TOKEN-AT-LEAST-24-CHARACTERS
# Origin can instead come from RENDER_EXTERNAL_URL or RAILWAY_PUBLIC_DOMAIN.
# Do not copy the placeholder above as a real setup token.
